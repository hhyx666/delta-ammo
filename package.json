{
  "name": "delta-ammo",
  "version": "1.0.0",
  "description": "三角洲子弹行情 - 价格走势与模拟盘",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.hhyx.deltaammo",
    "productName": "三角洲子弹行情",
    "directories": { "output": "dist" },
    "files": ["main.js", "web/**"],
    "win": {
      "target": "portable",
      "artifactName": "三角洲子弹行情-v${version}.exe"
    },
    "compression": "normal"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
